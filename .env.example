# --- RAG module (Person 3) --- copy to .env and fill in. NEVER commit .env
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME   # Neon: copy the connection string, change the prefix to postgresql+psycopg://
EMBEDDING_BACKEND=sentence-transformers          # 'spacy-standin' exists for tests only
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # set to the winner of compare_embedding_models
EMBEDDING_DIMENSION=                             # leave blank to measure; if set, it must equal the model's real size
TOP_K=5
KEYWORD_BACKEND=bm25                             # or 'fts' (PostgreSQL full-text search; label it FTS, not BM25)
RAG_STORE=                                       # blank = pg when DATABASE_URL is set, else 'file'
RAG_EMBEDDINGS_DIR=                              # only for RAG_STORE=file
# Used only until rag/evaluation/calibration.json has an entry for the model:
RAG_MIN_COSINE=0.5
RAG_MIN_COVERAGE=0.2
